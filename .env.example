# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────
# Project URL and anon key from supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────
# 64-char random secret for JWT signing: openssl rand -hex 32
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-chars

# Session cookie name and expiry (seconds)
ADMIN_COOKIE_NAME=dp_admin_session
ADMIN_SESSION_TTL=86400

# ─────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────
# Supabase Storage bucket name (create in Supabase dashboard → Storage)
SUPABASE_STORAGE_BUCKET=dermapride-media

# Maximum upload size in bytes (default 20 MB)
MAX_UPLOAD_SIZE=20971520

# ─────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://dermaprideclinics.com

# ─────────────────────────────────────────────
# Notifications (optional)
# ─────────────────────────────────────────────
# Booking form email / webhook (leave empty to disable)
BOOKING_WEBHOOK_URL=
BOOKING_EMAIL_TO=
